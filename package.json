{
  "name": "feishu-codex-bot",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql && cp src/agent/turn-output.schema.json dist/agent/turn-output.schema.json",
    "lint": "eslint .",
    "preflight": "tsx scripts/preflight.ts",
    "start": "node dist/main.js",
    "status": "node dist/status.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@openai/codex-sdk": "^0.152.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
